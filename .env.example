# Sentinel configuration. Copy to `.env` and adjust.
# The docker-compose demo points these at the bundled mocks by default.

# --- Zabbix (JSON-RPC endpoint, usually .../api_jsonrpc.php) ---
ZABBIX_URL=http://mock-zabbix:8080/api_jsonrpc.php
ZABBIX_USER=monitor
ZABBIX_PASS=monitor
ZABBIX_MIN_SEVERITY=4          # 4 = High, 5 = Disaster

# --- Prometheus (base URL; /api/v1/query is appended) ---
PROMETHEUS_URL=http://mock-prometheus:8080

# --- Ollama (self-hosted LLM). Point at a real Ollama to use real hardware. ---
OLLAMA_URL=http://mock-ollama:8080
OLLAMA_MODEL=qwen2.5:14b       # size it to the hardware you have, CPU included
OLLAMA_TIMEOUT=300             # generous on purpose: nothing waits on this

# --- Notification: "inbox" (demo/CI, writes to a file + stdout) or "telegram" ---
NOTIFIER=inbox
INBOX_PATH=/data/inbox.jsonl
TELEGRAM_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# --- Guardrails ---
DEDUP_COOLDOWN_SEC=60          # suppress re-alerts for the same trigger within this window
MASS_OUTAGE_THRESHOLD=8        # this many new problems in one cycle trips the circuit breaker

# --- Event window (v2) ---
# How far back a window may ever reach. It covers a skipped round automatically; the cap is
# what stops a watchdog that was down all weekend from replaying the whole weekend on the
# first round after it comes back.
EVENT_WINDOW_MAX_SEC=21600     # 6h

# --- Evidence layer (v2) ---
EVIDENCE_WINDOW_SEC=900        # how much history around the event to look at
SIBLINGS_MAX_HOSTS=8           # ceilings that keep "check the neighbours" from becoming a
SIBLINGS_MAX_ITEMS=12          # sweep of the monitoring API on a large host group

# --- Dead-man switch (v2) ---
# Written by the cycle, read by a SEPARATE timer. If the two shared a process they would die
# together, and the check would only ever report that everything is fine.
HEARTBEAT_FILE=/data/heartbeat.json
HEARTBEAT_MAX_AGE_SEC=600      # set this above your round interval, not equal to it

# --- State ---
STATE_FILE=/data/state.json
